sub init()
    m.top.functionName = "runTask"
end sub

sub runTask()
    request = m.top.request
    token = m.top.token

    if request = "signin"
        port = CreateObject("roMessagePort")
        req = CreateObject("roUrlTransfer")
        req.SetUrl("https://api.streamspindle.com/auth/signin")
        req.AddHeader("Content-Type", "application/json")
        req.AddHeader("Accept", "application/json")
        req.SetRequest("POST")
        req.SetPort(port)
        req.AsyncPostFromString("{""email"":""davidjamesobrien@me.com"",""password"":""StreamSpindle99""}")
        msg = wait(30000, port)
        if type(msg) = "roUrlEvent"
            response = msg.GetString()
            data = ParseJSON(response)
            if data <> invalid and data.token <> invalid
                m.top.result = { success: true, token: data.token }
            else
                m.top.result = { success: false, error: "signin failed: " + response }
            end if
        else
            m.top.result = { success: false, error: "timeout" }
        end if

    else if request = "catalog"
        port = CreateObject("roMessagePort")
        req = CreateObject("roUrlTransfer")
        req.SetUrl("https://api.streamspindle.com/catalog?status=live")
        req.AddHeader("Authorization", "Bearer " + token)
        req.AddHeader("Accept", "application/json")
        req.SetPort(port)
        req.AsyncGetToString()
        msg = wait(30000, port)
        if type(msg) = "roUrlEvent"
            response = msg.GetString()
            data = ParseJSON(response)
            if data <> invalid and data.catalog <> invalid
                m.top.result = { success: true, catalog: data.catalog }
            else
                m.top.result = { success: false, error: "catalog failed: " + response }
            end if
        else
            m.top.result = { success: false, error: "timeout" }
        end if
    end if
end sub
